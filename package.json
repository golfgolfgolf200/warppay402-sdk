{
  "name": "@warppay402/sdk",
  "version": "1.0.6",
  "description": "Official TypeScript SDK for WarpPay402 pay-per-use AI tools on Base Mainnet",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golfgolfgolf200/warppay402-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/golfgolfgolf200/warppay402-sdk/issues"
  },
  "homepage": "https://github.com/golfgolfgolf200/warppay402-sdk#readme",
  "keywords": [
    "x402",
    "base",
    "ai-agents",
    "mcp",
    "monetization",
    "langchain"
  ],
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@warppay402/server": "^1.0.0",
    "bs58": "^6.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.0.0"
  },
  "openclaw": {
    "compat": {
      "pluginApi": "1.0.0"
    },
    "build": {
      "openclawVersion": "1.0.0"
    },
    "extensions": [
      "dist/index.js"
    ],
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateKey": {
          "type": "string",
          "description": "Base wallet private key for paying x402 micropayments"
        }
      }
    }
  }
}
