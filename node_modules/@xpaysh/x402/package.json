{
  "name": "@xpaysh/x402",
  "version": "0.1.2",
  "description": "XPay facilitator for the x402 payment protocol — open, no auth required",
  "author": "XPay <hello@xpay.sh> (https://xpay.sh)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpaysh/xpay-x402"
  },
  "homepage": "https://www.xpay.sh/x402-facilitators/xpay/",
  "keywords": [
    "x402",
    "payments",
    "web3",
    "USDC",
    "facilitator",
    "base",
    "coinbase",
    "ai-agents",
    "http-402",
    "payment-protocol"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
